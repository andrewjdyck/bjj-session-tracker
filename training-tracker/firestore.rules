rules_version = '2';

// Firestore security rules for the BJJ Training Tracker.
// This file is the source of truth: deploy with
//   firebase deploy --only firestore:rules                  (dev, the default)
//   firebase deploy --only firestore:rules --project prod   (prod)
// Rules edited in the Firebase console will be overwritten by the next deploy.
// Tests: npm run test:rules (runs against the local emulator).
//
// The Admin SDK (seed/wipe scripts, server routes) bypasses these rules.
// Anything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // LEGACY: the old browser-maintained community total. The app now computes
    // the total on the server (/api/community-stats), so nothing writes this
    // any more. Kept read-only so browsers still running the old code don't
    // error; the rule and the doc can be deleted later.
    match /stats/global {
      allow read: if true;
    }

    // Each user's profile and everything under it (sessions, events) is
    // private to that user.
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false; // account deletion is not supported in the app yet

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
