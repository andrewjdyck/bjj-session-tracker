rules_version = '2';

// Firestore security rules for the BJJ Training Tracker.
// This file is the source of truth: deploy with
//   firebase deploy --only firestore:rules                  (dev, the default)
//   firebase deploy --only firestore:rules --project prod   (prod)
// Rules edited in the Firebase console will be overwritten by the next deploy.
// Tests: npm run test:rules (runs against the local emulator).
//
// The Admin SDK (seed/wipe scripts, server routes) bypasses these rules.
// Anything not matched below is denied.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Community total shown on the landing page.
    match /stats/global {
      allow read: if true;

      // TEMPORARY: the browser updates this total after logging a session
      // (lib/stats.ts). Remove client writes once the total is calculated on
      // the server (tasks.md section 2). Until then, limit tampering: only the
      // two known fields, a non-negative number, and at most one day's worth of
      // minutes per write.
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['totalTrainingMinutes', 'lastUpdated'])
        && request.resource.data.totalTrainingMinutes is number
        && request.resource.data.totalTrainingMinutes >= 0
        && request.resource.data.totalTrainingMinutes <= 1440;
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['totalTrainingMinutes', 'lastUpdated'])
        && request.resource.data.totalTrainingMinutes is number
        && request.resource.data.totalTrainingMinutes >= 0
        && request.resource.data.totalTrainingMinutes - resource.data.totalTrainingMinutes <= 1440
        && request.resource.data.totalTrainingMinutes - resource.data.totalTrainingMinutes >= -1440;
    }

    // Each user's profile and everything under it (sessions, events) is
    // private to that user.
    match /users/{uid} {
      allow read, create, update: if isOwner(uid);
      allow delete: if false; // account deletion is not supported in the app yet

      match /{subcollection}/{docId} {
        allow read, write: if isOwner(uid);
      }
    }
  }
}
